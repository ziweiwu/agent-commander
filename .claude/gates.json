{
  "watch": [
    "src/",
    "rust/",
    "test/",
    "scripts/",
    "package.json",
    "package-lock.json",
    "tsconfig.json"
  ],
  "gates": [
    [
      "typecheck",
      [
        "npm",
        "run",
        "typecheck"
      ]
    ],
    [
      "lint",
      [
        "npm",
        "run",
        "lint"
      ]
    ],
    [
      "test",
      [
        "npm",
        "test"
      ]
    ]
  ],
  "timeout": 600
}
