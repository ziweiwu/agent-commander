node_modules/
dist/
*.log

# The locally built macOS launcher app (`npm run app`). Deliberately not under
# dist/, which package.json ships wholesale — a local `npm run app` followed by
# a local `npm publish` would put the whole .app inside the tarball.
build/
.DS_Store

# Rust build artefacts. The port itself lives on `experiment/rust-backend` and
# not on this line; this entry is here so that checking that branch out,
# building, and coming back does not leave 849M of untracked noise behind.
rust/target/

# Worktrees this repo's own agents check out into
.claude/worktrees/

# Stop-hook bookkeeping: which tree state the gate list last ran against
.claude/.verify-gate-state.json

# Playwright e2e output
test-results/
playwright-report/
blob-report/
.playwright/

# Python bytecode from the generator and the audit scripts
__pycache__/
