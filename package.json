{
  "name": "@ziweiwu/agent-commander",
  "version": "0.11.0",
  "description": "See every Claude Code and Kiro CLI agent on your machine at a glance — status, folder, progress — and drop into any one of them from the browser.",
  "license": "MIT",
  "author": "Ziwei Wu <ziweiwu@gmail.com>",
  "keywords": [
    "claude",
    "claude-code",
    "agent",
    "dashboard",
    "tmux",
    "cli",
    "monitoring"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ziweiwu/agent-commander.git"
  },
  "homepage": "https://github.com/ziweiwu/agent-commander#readme",
  "bugs": {
    "url": "https://github.com/ziweiwu/agent-commander/issues"
  },
  "type": "module",
  "bin": {
    "agent-commander": "scripts/launch.mjs"
  },
  "files": [
    "dist",
    "scripts/launch.mjs",
    "scripts/statusline-bridge.mjs",
    "README.md",
    "INVARIANTS.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "npm run build:web && npm run build:server",
    "build:server": "./scripts/cargo.sh build --release --manifest-path rust/Cargo.toml",
    "build:dist-bin": "./scripts/dist-bin.sh",
    "build:web": "vite build",
    "dev": "./scripts/cargo.sh build --release --manifest-path rust/Cargo.toml && rust/target/release/agent-commander --dev --port 4400",
    "lint": "oxlint && ./scripts/cargo.sh clippy --manifest-path rust/Cargo.toml -- -D warnings",
    "lint:fix": "oxlint --fix",
    "mock": "npm run build:web && ./scripts/cargo.sh build --release --manifest-path rust/Cargo.toml && rust/target/release/agent-commander --mock --port 4400",
    "start": "npm run build:web && ./scripts/cargo.sh build --release --manifest-path rust/Cargo.toml && rust/target/release/agent-commander",
    "test": "vitest run && ./scripts/cargo.sh test --manifest-path rust/Cargo.toml",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "verify:inv1": "tsx scripts/verify-inv1.ts",
    "serve": "./scripts/cargo.sh build --release --manifest-path rust/Cargo.toml && rust/target/release/agent-commander",
    "app": "npm run build && python3 scripts/build-mac-app.py",
    "app:install": "npm run build && python3 scripts/build-mac-app.py --install",
    "audit": "npm run audit:contrast && npm run audit:a11y && npm run audit:ux && npm run audit:mobile",
    "audit:contrast": "python3 scripts/audit-contrast.py",
    "audit:a11y": "node scripts/audit-a11y.mjs",
    "audit:ux": "node scripts/audit-ux.mjs",
    "audit:mobile": "node scripts/audit-mobile.mjs",
    "qa": "./scripts/qa-sweep.sh",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:report": "playwright show-report",
    "themes": "python3 scripts/gen-themes.py --write",
    "test:web": "vitest run",
    "test:server": "./scripts/cargo.sh test --manifest-path rust/Cargo.toml",
    "gen:types": "WIRE_WRITE=1 ./scripts/cargo.sh test --manifest-path rust/Cargo.toml the_checked_in_wire_contract_is_current",
    "lint:web": "oxlint"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "@xterm/xterm": "^5.5.0",
    "jsdom": "^30.0.1",
    "oxlint": "^1.77.0",
    "playwright": "^1.62.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^4.1.10",
    "zustand": "^5.0.15"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
