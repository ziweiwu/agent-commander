{
  "name": "agent-commander",
  "version": "0.1.0",
  "description": "See every Claude Code agent on your machine at a glance \u2014 status, folder, progress \u2014 and drop into any one of them from the browser.",
  "type": "module",
  "bin": {
    "agent-commander": "dist/server/cli.js"
  },
  "scripts": {
    "build": "npm run build:web && npm run build:server",
    "build:server": "tsc -p tsconfig.build.json",
    "build:web": "vite build",
    "dev": "tsx watch src/server/cli.ts --dev",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "mock": "npm run build:web && tsx src/server/cli.ts --mock",
    "start": "npm run build:web && tsx src/server/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "verify:inv1": "tsx scripts/verify-inv1.ts",
    "serve": "tsx src/server/cli.ts"
  },
  "dependencies": {
    "@xterm/xterm": "^5.5.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/ws": "^8.5.13",
    "oxlint": "^1.77.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20"
  }
}
