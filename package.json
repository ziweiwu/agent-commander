{
  "name": "@ziweiwu/agent-commander",
  "version": "0.2.1",
  "description": "See every Claude Code agent on your machine at a glance — status, folder, progress — and drop into any one of them from the browser.",
  "license": "MIT",
  "author": "Ziwei Wu <ziweiwu@gmail.com>",
  "keywords": [
    "claude",
    "claude-code",
    "agent",
    "dashboard",
    "tmux",
    "cli",
    "monitoring"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ziweiwu/agent-commander.git"
  },
  "homepage": "https://github.com/ziweiwu/agent-commander#readme",
  "bugs": {
    "url": "https://github.com/ziweiwu/agent-commander/issues"
  },
  "type": "module",
  "bin": {
    "agent-commander": "dist/server/cli.js"
  },
  "files": [
    "dist",
    "scripts/statusline-bridge.mjs",
    "README.md",
    "INVARIANTS.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "npm run build:web && npm run build:server",
    "build:server": "tsc -p tsconfig.build.json",
    "build:web": "vite build",
    "dev": "tsx watch src/server/cli.ts --dev --port 4400",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "mock": "npm run build:web && tsx src/server/cli.ts --mock --port 4400",
    "start": "npm run build:web && tsx src/server/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "verify:inv1": "tsx scripts/verify-inv1.ts",
    "serve": "tsx src/server/cli.ts",
    "audit": "npm run audit:contrast && npm run audit:a11y && npm run audit:ux && npm run audit:mobile",
    "audit:contrast": "python3 scripts/audit-contrast.py",
    "audit:a11y": "node scripts/audit-a11y.mjs",
    "audit:ux": "node scripts/audit-ux.mjs",
    "audit:mobile": "node scripts/audit-mobile.mjs",
    "qa": "./scripts/qa-sweep.sh",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:report": "playwright show-report",
    "themes": "python3 scripts/gen-themes.py --write"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^5.2.0",
    "@xterm/xterm": "^5.5.0",
    "jsdom": "^30.0.1",
    "oxlint": "^1.77.0",
    "playwright": "^1.62.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^4.1.10",
    "zustand": "^5.0.15"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
